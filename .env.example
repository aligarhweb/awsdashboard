# Server & Environment
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# Database (Hostinger MySQL)
# Keep connection pool small (connection_limit=5 or 10) for managed MySQL limits
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME?connection_limit=5"

# Security Secrets (generate strong random 32+ byte hex strings in production)
# SESSION_SECRET is used to sign session cookies; ENCRYPTION_KEY (64 hex chars = 32 bytes) encrypts stored API credentials via AES-256-GCM
SESSION_SECRET=""
ENCRYPTION_KEY=""

# Cron Endpoint Protection (pass in header x-cron-secret when calling POST /api/cron/tick)
CRON_SECRET=""

# Optional In-Process Cron Fallback ("true" by default; set "false" if relying solely on external Hostinger/cron-job.org tick)
ENABLE_IN_PROCESS_CRON="true"

# Optional Bootstrap Owner Email/Password (only needed if seeding via CLI instead of the first-run setup page)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Aligarh Web Solutions"

# SMTP Defaults (can also be configured in the Settings UI)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Aligarh Web Solutions"
SMTP_FROM_EMAIL=""

# Meta WhatsApp Cloud API (can also be configured encrypted in Settings UI)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
